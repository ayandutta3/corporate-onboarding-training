# Application Settings
APP_NAME="Corporate Onboarding and Training API"
APP_ENV="development"
DEBUG=True

# MongoDB Settings
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="onboarding_db"

# OpenAI & API Endpoint Settings
OPENAI_API_KEY="your-openai-api-key"
OPENAI_API_BASE=""
API_ENDPOINT=""

# Model Deployment Settings
LLM_MODEL="azure/genailab-maas-gpt-4o-mini"
EMBEDDING_MODEL="azure/genailab-maas-text-embedding-3-large"
WHISPER_MODEL="azure/genailab-maas-whisper"

# Langfuse Settings
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_HOST="https://us.cloud.langfuse.com"

# JWT Settings
JWT_SECRET_KEY="your-super-secret-jwt-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
